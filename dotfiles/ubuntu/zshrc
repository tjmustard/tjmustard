# ~/.zshrc
# Edit with `zshrc`, reload with `usource`.
# Adapted for Ubuntu: tools come from apt, Homebrew is used only if present.

# --- Homebrew (optional) ----------------------------------------------------
[[ -x /opt/homebrew/bin/brew ]] && eval "$(/opt/homebrew/bin/brew shellenv)"
[[ -x /home/linuxbrew/.linuxbrew/bin/brew ]] && eval "$(/home/linuxbrew/.linuxbrew/bin/brew shellenv)"

# --- Exports ----------------------------------------------------------------
typeset -U path                      # drop duplicate PATH entries
path=("$HOME/.local/bin" "$HOME/bin" $path)
export EDITOR=vim
export VISUAL=$EDITOR
export LANG=en_US.UTF-8
export CLICOLOR=1                    # coloured `ls` on macOS (harmless on Linux)
[[ -f "$HOME/.cargo/env" ]] && source "$HOME/.cargo/env"

# --- History ----------------------------------------------------------------
HISTFILE=~/.zsh_history
HISTSIZE=50000
SAVEHIST=50000
setopt SHARE_HISTORY                 # one history across open tabs
setopt HIST_IGNORE_ALL_DUPS          # keep only the newest copy of a command
setopt HIST_IGNORE_SPACE             # a leading space keeps a command out of history
setopt HIST_REDUCE_BLANKS
setopt EXTENDED_HISTORY              # store timestamps
setopt HIST_VERIFY                   # show an expanded history command before running it

# --- Options ----------------------------------------------------------------
setopt AUTO_CD                       # type a directory name to enter it
setopt AUTO_PUSHD PUSHD_IGNORE_DUPS  # `cd -<Tab>` walks recent directories
setopt INTERACTIVE_COMMENTS          # allow a # comment at the prompt

# --- Completion -------------------------------------------------------------
autoload -Uz compinit && compinit
zstyle ':completion:*' menu select
zstyle ':completion:*' matcher-list 'm:{a-z}={A-Za-z}'

# --- Aliases ----------------------------------------------------------------
alias usource='source ~/.zshrc && echo "zshrc reloaded"'
alias zshrc='${EDITOR} ~/.zshrc'

[[ $OSTYPE == linux* ]] && alias ls='ls --color=auto'
alias ll='ls -l'
alias la='ls -la'
alias ..='cd ..'
alias ...='cd ../..'
alias grep='grep --color=auto'

alias gs='git status'
alias gd='git diff'
alias ga='git add'
alias gc='git commit'
alias gp='git push'
alias gl='git log --oneline --graph --decorate -20'

command -v eza >/dev/null && alias lt='eza -T --git-ignore'
# Ubuntu ships bat as `batcat`
if command -v bat >/dev/null; then
  alias cat='bat --paging=never'
elif command -v batcat >/dev/null; then
  alias bat='batcat'
  alias cat='batcat --paging=never'
fi

# --- Functions --------------------------------------------------------------
mkcd() { mkdir -p "$1" && cd "$1"; }

# --- Tools (each is skipped when its binary is missing) ----------------------
command -v starship >/dev/null && eval "$(starship init zsh)"
command -v zoxide   >/dev/null && eval "$(zoxide init zsh)"      # z and zi
command -v fzf      >/dev/null && source <(fzf --zsh)            # Ctrl-R, Ctrl-T, Alt-C

# Plugin locations: apt puts them in /usr/share, Homebrew under its prefix
ZSH_PLUGIN_DIRS=(/usr/share)
command -v brew >/dev/null && ZSH_PLUGIN_DIRS=("${HOMEBREW_PREFIX:-$(brew --prefix)}/share" $ZSH_PLUGIN_DIRS)

for d in $ZSH_PLUGIN_DIRS; do
  if [[ -f $d/zsh-autosuggestions/zsh-autosuggestions.zsh ]]; then
    source $d/zsh-autosuggestions/zsh-autosuggestions.zsh; break
  fi
done

# --- Local overrides --------------------------------------------------------
# Machine-specific settings and secrets belong here, never in this file.
if [[ -f ~/.zshrc.local ]]; then source ~/.zshrc.local; fi

# Syntax highlighting must load last, after the aliases it colours.
for d in $ZSH_PLUGIN_DIRS; do
  if [[ -f $d/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh ]]; then
    source $d/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh; break
  fi
done
unset d
